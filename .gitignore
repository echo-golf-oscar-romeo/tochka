# Env
.env
.env.local
.env.*.local
*.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.npm/

# Data — large or scraped, never commit (per-folder allowlist below)
data/*
!data/.gitkeep
!data/README.md
# Kontur population parquet is small (~25 KB) and required for opportunity
# scoring — commit it so the backend boots with real population hexes.
!data/kontur/
data/kontur/*
!data/kontur/kontur_pop_hk.parquet
# Real CSDI / HK gov open data — small enough to commit so the backend
# boots with genuine Hong Kong POIs + district boundaries.
!data/csdi/
data/csdi/*
!data/csdi/csdi_pois.parquet
!data/csdi/hk_districts.geojson
# DuckDB databases anywhere in the tree
*.duckdb
*.duckdb.wal
backend/data/

# IDE
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs / tmp
*.log
.tmp/
.cache/

# uv
.uv/
uv.lock.bak

# Local secrets / API keys
*.pem
*.key
secrets/
