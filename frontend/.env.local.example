NEXT_PUBLIC_API_BASE=http://localhost:8000

# Basemap. Three options, in order of preference:
#
#   1. NEXT_PUBLIC_BASEMAP_STYLE — any raw style URL (overrides everything).
#   2. NEXT_PUBLIC_MAPBOX_STYLE_URL + NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN —
#      a `mapbox://styles/<user>/<style>` URI + your public token. The app
#      converts it to a Style API URL with the token appended.
#   3. (fallback) Carto Positron — robust default, no auth required.
#
# To use the kuttin29 Tochka-tuned style, leave option 1 blank and set:
#
NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/kuttin29/cle9gqh0800cz01ogvsshlmyv
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
#
# If both 1 and 2 are blank, the app uses Carto Positron.
NEXT_PUBLIC_BASEMAP_STYLE=
