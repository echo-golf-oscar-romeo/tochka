# ====== LLM ======
# Alibaba Cloud DashScope (Qwen). Get from dashscope.console.aliyun.com.
# International endpoint differs from cn-hangzhou — set both if needed.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
QWEN_MODEL=qwen-max

# ====== CSDI ======
# As of writing, most CSDI Map APIs and FSDT downloads are public and do not
# require an API key. Confirm against portal.csdi.gov.hk/csdi-webpage/apilist
# before relying on this. If a key is later required, set it here.
CSDI_API_KEY=
CSDI_BASE_URL=https://www.als.gov.hk

# Vector Map tiles (basemap). The CSDI Vector Map style URL is public; we
# pin it here so the frontend can read it via NEXT_PUBLIC_*.
NEXT_PUBLIC_CSDI_VECTOR_STYLE=https://mapapi.geodata.gov.hk/gs/api/v1.0.0/styleSheet/vector

# ====== Backend ======
APP_ENV=development         # development | demo | production
APP_PORT=8000
# 'demo' mode short-circuits real network calls and returns canned data
# so the live Qwenched demo is deterministic.
DEMO_MODE=true

# ====== Frontend ======
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ====== Data ======
# Local OSM HK extract for OSRM fallback isochrones.
OSM_HK_PBF_PATH=./data/hong-kong-latest.osm.pbf
DUCKDB_PATH=./data/tochka.duckdb
