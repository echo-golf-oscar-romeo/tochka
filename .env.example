# ====== LLM ======
# Tochka uses an OpenAI-compatible Chat Completions endpoint and supports two
# providers out of the box. Switch by changing LLM_PROVIDER below.
#
#   qwen     — Alibaba Cloud DashScope (intended primary; Qwenched sponsor)
#   deepseek — DeepSeek (temporary workaround while DashScope account is
#              pending activation; same prompt/tooling, different vendor)
#
LLM_PROVIDER=qwen

# --- Qwen / Alibaba DashScope ---
# Get key at dashscope.console.aliyun.com. OpenAI-compatible endpoint docs:
# https://help.aliyun.com/zh/dashscope/developer-reference/compatibility-of-openai-with-dashscope
# International host: dashscope-intl.aliyuncs.com. Mainland: dashscope.aliyuncs.com.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

# --- DeepSeek (fallback while DashScope is pending) ---
# Get key at platform.deepseek.com. Set LLM_PROVIDER=deepseek above to activate.
# Models: deepseek-chat (V3, general purpose), deepseek-reasoner (R1).
# For Tochka's clarify + narrative use case deepseek-chat is the right default.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ====== CSDI ======
# As of writing, most CSDI Map APIs and FSDT downloads are public and do not
# require an API key. Confirm against portal.csdi.gov.hk/csdi-webpage/apilist
# before relying on this. If a key is later required, set it here.
CSDI_API_KEY=
CSDI_BASE_URL=https://www.als.gov.hk

# Basemap (Carto Positron by default — light, subtle, Aino-style).
# The original CSDI Vector Map URL currently 404s; when CSDI republishes
# a working style URL, set NEXT_PUBLIC_BASEMAP_STYLE here.
NEXT_PUBLIC_BASEMAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
# Legacy alias for backward-compat; remove once CSDI is back.
NEXT_PUBLIC_CSDI_VECTOR_STYLE=

# ====== Mapbox ======
# Used for walking/driving isochrone polygons. CSDI's 3D Pedestrian Route
# Search is route-to-route, not area-to-polygon, so Mapbox is the primary
# isochrone provider. Free tier: 100k requests/month — plenty for the demo.
# Get a public token at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=

# ====== Backend ======
APP_ENV=development         # development | demo | production
APP_PORT=8000
# DEMO_MODE=true forces canned data for every spatial tool (geocoding,
# isochrones, competitors, population) so the live Qwenched demo is
# deterministic against venue WiFi. LLM calls are independent — Qwen is
# called whenever DASHSCOPE_API_KEY is set, even in demo mode.
DEMO_MODE=false

# ====== Frontend ======
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ====== Data ======
# Pre-fetched OSM banks + ATMs for HK (generate via:
#   cd backend && uv run python scripts/fetch_osm_banks.py)
OSM_BANKS_PATH=./data/osm/banks_atms_hk.json
# Optional: OSM HK extract for future OSRM-based driving isochrones.
OSM_HK_PBF_PATH=./data/hong-kong-latest.osm.pbf
DUCKDB_PATH=./data/tochka.duckdb
